# Copy this file to .env and fill in what you have.
# Everything is optional: with no keys, Oja runs in offline demo mode
# (rule-based assistant + simulated PayPal) so anyone can try it.

# --- AI: Google Gemini (free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- PayPal sandbox (https://developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Your sandbox BUSINESS account email (shown as the invoice sender)
PAYPAL_MERCHANT_EMAIL=

# --- Store ---
STORE_NAME=Danzora
STORE_TAGLINE=Gadgets that work as hard as you do
FREE_SHIPPING_FROM=150
FLAT_SHIPPING=5
# Naira per US dollar, used to show naira prices (official NFEM rate)
NGN_PER_USD=1333.54

# Optional: protect the seller dashboard with a key
SELLER_KEY=

PORT=3000
